<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for building against the HeroDevs NES registry.

    NES_TOKEN=<your NES access token> ./mvnw -s settings.xml clean package

  The registry ignores the user name; the access token is the password. Maven reads
  it from the NES_TOKEN environment variable, so the token never has to be written
  to a file. The server id must match the repository id in pom.xml.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <servers>
    <server>
      <id>herodevs-nes-registry</id>
      <username>nes</username>
      <password>${env.NES_TOKEN}</password>
    </server>
  </servers>
</settings>
